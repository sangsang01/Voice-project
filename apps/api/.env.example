# Copy to .env and fill in for local development. Never commit the real .env file.

# Required outside test mode. Exact, comma-separated match against the
# WebSocket upgrade request's Origin header -- no wildcards, no subdomain
# matching. The gateway destroys any upgrade whose Origin is not a member.
ALLOWED_ORIGINS=http://localhost:5173

# TCP port the HTTP/WebSocket server listens on.
PORT=8080

# Optional overrides. Each is validated at startup against a documented safe
# ceiling; an out-of-range or non-integer value refuses to start rather than
# silently running with a weaker limit.
# IDLE_TIMEOUT_MS=30000        # default 30_000, ceiling 300_000
# HARD_TIMEOUT_MS=600000       # default 600_000, ceiling 1_800_000
# MAX_BUFFERED_AUDIO_MS=2000   # default 2_000, ceiling 10_000
# MAX_CONCURRENT_SESSIONS=20   # default 20, ceiling 200

# Google credentials are never read from this file. See README.md for
# Application Default Credentials setup -- gcloud auth application-default
# login (local) or workload identity / a service account (deployed).
