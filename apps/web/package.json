{
  "name": "@voice/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "benchmark": "playwright test --config playwright.config.ts --grep benchmark",
    "typecheck": "tsc -b --pretty false",
    "test:typecheck": "tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@voice/local-whisper-engine": "*",
    "@voice/remote-whisper-engine": "*",
    "@voice/transcription-contracts": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
